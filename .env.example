# Create an instance once:
#   curl -X POST https://api.agent37.com/v1/instances \
#     -H "Authorization: Bearer $AGENT37_API_KEY" \
#     -H "Content-Type: application/json" \
#     -d '{"template":"agent37-hermes","budget":{"credit_micros":1000000}}'
# Then set your instance ID and URL below:
